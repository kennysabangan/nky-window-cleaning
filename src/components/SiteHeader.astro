---
import { siteConfig } from '../config';

const { phone, phoneE164, businessName } = siteConfig;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/window-cleaning/', label: 'Service Areas' },
  { href: '/guides/', label: 'Guides' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">{businessName}</a>
    <nav class="nav-wrap" aria-label="Main">
      <ul class="nav-links">
        {links.map((l) => (
          <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a href={`tel:${phoneE164}`} class="phone-btn">📞 {phone}</a>
  </div>
</header>

<style>
  .site-header {
    background: #1a6bb5;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
    gap: 1rem;
  }
  .brand {
    display: none;
    color: #fff;
    font-weight: 800;
    font-size: 1.05rem;
    text-decoration: none;
  }
  .phone-btn {
    color: #fff;
    font-size: 1.3rem;
    font-weight: 700;
    text-decoration: none;
    margin-left: auto;
  }
  .nav-wrap { display: none; }
  .nav-links {
    display: flex;
    gap: 1.5rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links a { color: #fff; text-decoration: none; }
  .nav-links a[aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; }
  @media (min-width: 900px) {
    .brand { display: block; }
    .nav-wrap { display: block; }
    .phone-btn { margin-left: 0; }
  }
</style>
