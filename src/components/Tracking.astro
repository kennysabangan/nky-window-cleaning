---
/**
 * Tracking.astro — one place for conversion tracking on every page.
 *
 * Sends each event to Vercel Web Analytics (custom events need a Pro plan;
 * otherwise they're dropped) and to GA4 when a measurement ID is configured.
 *
 * Events:
 *   phone_click     any tel: link, with where on the page it was tapped
 *   email_click     any mailto: link
 *   outbound_click  links to other sites
 *   form_start      first focus inside a form
 *   generate_lead   quote form sent successfully (call window.nkyTrack from the form)
 */
---

<script>
  import { track } from '@vercel/analytics';

  type EventData = Record<string, string | number | boolean | null>;

  function send(name: string, data: EventData = {}) {
    const payload: EventData = { ...data, page: location.pathname };
    try { track(name, payload); } catch { /* analytics must never break the page */ }
    const w = window as any;
    if (typeof w.gtag === 'function') w.gtag('event', name, payload);
  }

  (window as any).nkyTrack = send;

  function placement(el: Element): string {
    if (el.closest('.site-header, header')) return 'header';
    if (el.closest('.sticky-mobile-cta')) return 'sticky_bar';
    if (el.closest('footer')) return 'footer';
    if (el.closest('form, .form-card')) return 'form';
    if (el.closest('.final-cta, .cta-strip, .guide-cta, .cta-section')) return 'cta';
    if (el.closest('.page-hero, .hero-section, .hero-col')) return 'hero';
    return 'body';
  }

  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
    if (!a) return;
    const href = a.getAttribute('href') || '';
    if (href.startsWith('tel:')) send('phone_click', { placement: placement(a) });
    else if (href.startsWith('mailto:')) send('email_click', { placement: placement(a) });
    else if (a.host && a.host !== location.host) send('outbound_click', { url: a.href });
  }, { capture: true });

  let formStarted = false;
  document.addEventListener('focusin', (e) => {
    if (formStarted || !(e.target as Element | null)?.closest?.('form')) return;
    formStarted = true;
    send('form_start');
  });
</script>
