---
import BaseLayout from './BaseLayout.astro';
import EnhancedFAQ from '../components/EnhancedFAQ.astro';
import { siteConfig } from '../config';
import type { FAQ } from '../config';

interface Props {
  slug: string;
  title: string;
  description: string;
  heading: string;
  lede: string;
  faqs?: FAQ[];
}

const { slug, title, description, heading, lede, faqs = [] } = Astro.props;
const { businessName, phone, phoneE164, siteUrl, guides, cities } = siteConfig;
const url = `${siteUrl}/guides/${slug}/`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": heading,
  "description": description,
  "mainEntityOfPage": url,
  "image": `${siteUrl}/og-image.png`,
  "author": { "@type": "Organization", "name": businessName, "url": siteUrl },
  "publisher": { "@type": "Organization", "name": businessName, "url": siteUrl },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Guides", "item": `${siteUrl}/guides/` },
    { "@type": "ListItem", "position": 3, "name": heading, "item": url },
  ],
};

const related = guides.filter((g) => g.slug !== slug);
---

<BaseLayout title={title} description={description} canonicalURL={url} schema={[articleSchema, breadcrumbSchema]}>

<section class="hero-section">
  <div class="container">
    <h1>{heading}</h1>
    <p class="hero-sub">{lede}</p>
  </div>
</section>

<article class="content-section guide-body">
  <slot />
</article>

{faqs.length > 0 && (
  <div class="container">
    <EnhancedFAQ faqs={faqs} title="Common Questions" />
  </div>
)}

<div class="content-section">
  <div class="guide-cta">
    <p class="guide-cta-title">Want a pro to handle it?</p>
    <p>Free estimates for homes and storefronts in {cities.map((c) => c.name.replace(/, KY$/, '')).join(', ')}, and nearby.</p>
    <a href={`tel:${phoneE164}`} class="btn-brand">📞 Call {phone}</a>
  </div>

  <h2 class="text-brand text-xl font-bold mt-10 mb-3">More Guides</h2>
  <ul>
    {related.map((g) => (
      <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>
    ))}
  </ul>
</div>

</BaseLayout>

<style is:global>
  .guide-body h2 {
    color: var(--color-brand);
    font-size: 1.4rem;
    font-weight: 700;
    margin: 2rem 0 0.75rem 0;
    line-height: 1.3;
  }
  .guide-body h3 {
    color: #333;
    font-size: 1.1rem;
    font-weight: 700;
    margin: 1.5rem 0 0.5rem 0;
  }
  .guide-body ol {
    padding-left: 1.25rem;
    color: #444;
    line-height: 1.8;
  }
  .guide-body ol li { margin-bottom: 0.6rem; }
  .guide-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem 0;
    font-size: 0.95rem;
  }
  .guide-body th, .guide-body td {
    border-bottom: 1px solid #e5e7eb;
    padding: 0.6rem 0.5rem;
    text-align: left;
    vertical-align: top;
  }
  .guide-body th { color: var(--color-brand); }
  .guide-body .callout {
    background: #e8f4f8;
    border-left: 4px solid var(--color-brand);
    border-radius: 0 8px 8px 0;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
  }
  .guide-body .callout p:last-child { margin-bottom: 0; }
  .guide-cta {
    background: var(--color-brand);
    color: #fff;
    border-radius: 12px;
    padding: 1.75rem 1.25rem;
    text-align: center;
  }
  .guide-cta p { color: var(--color-brand-light) !important; }
  .guide-cta .guide-cta-title { color: #fff !important; font-size: 1.3rem; font-weight: 700; margin-bottom: 0.35rem; }
</style>
