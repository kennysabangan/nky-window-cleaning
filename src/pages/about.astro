---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import { siteConfig } from '../config';

const { businessName, phone, siteUrl, serviceKeyword, city, cities, services } = siteConfig;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": `${siteUrl}/about/` },
  ],
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": `About ${businessName}`,
  "description": `${businessName} provides residential and storefront ${serviceKeyword} in ${city}.`,
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": businessName,
    "telephone": siteConfig.phoneE164,
  },
};
---

<BaseLayout
  title={`About Us | ${businessName}`}
  description={`${businessName} cleans windows for homes and storefronts in Florence, Covington, Fort Thomas, Newport, and across Northern Kentucky. How we work, what we clean, and where we go.`}
  canonicalURL={`${siteUrl}/about/`}
  schema={[breadcrumbSchema, aboutPageSchema]}
>

<section class="hero-section">
  <div class="container">
    <h1>About {businessName}</h1>
    <p class="hero-sub">Window cleaning for Northern Kentucky homes and storefronts.</p>
    <PhoneCTA />
  </div>
</section>

<div class="container py-6 text-center">
  <img
    src="/photos/team.jpg"
    alt="Window cleaning crew with poles and squeegees"
    class="site-photo mx-auto max-w-2xl"
    loading="eager"
  />
</div>

<div class="content-section">
  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4">What We Do</h2>

  <p>We clean windows — that's the whole business. Inside and outside glass, frames, sills, screens, and tracks for houses in Boone, Kenton, and Campbell counties, plus recurring storefront routes for shops, restaurants, and offices.</p>

  <ul>
    {services.map((s) => (
      <li><strong>{s.title}</strong> — {s.description}</li>
    ))}
  </ul>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">How a Job Works</h2>

  <p><strong>1. Quote.</strong> Call {phone} or send the form. Tell us roughly how many windows, whether you want inside, outside, or both, and anything unusual — storm windows, tall foyer glass, sprinkler spots, paint or stickers. Most quotes are given over the phone.</p>

  <p><strong>2. Cleaning.</strong> Reachable glass is scrubbed and squeegeed by hand. Upper-story exterior glass is cleaned from the ground with a water-fed pole where possible. Screens are brushed and rinsed and tracks are vacuumed and wiped.</p>

  <p><strong>3. Walk-through.</strong> Before we leave, look the windows over with us. If anything was missed, it gets redone on the spot.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">Where We Work</h2>

  <p>Our main service areas are {cities.map((c) => c.name.replace(/, KY$/, '')).join(', ')}. Each city page covers the homes and window types we see most there:</p>

  <ul>
    {cities.map((c) => (
      <li><a href={`/window-cleaning/${c.slug}/`}>Window cleaning in {c.name}</a></li>
    ))}
  </ul>

  <p>Close by but not on the list? Call {phone} and ask — nearby towns are often fine.</p>
</div>

<section class="bg-gray-50 border-y-2 border-brand">
  <div class="cta-strip container">
    <p class="cta-heading">Ready to Get Your Windows Cleaned?</p>
    <p class="cta-sub">Call now for a free estimate.</p>
    <PhoneCTA />
  </div>
</section>

</BaseLayout>
