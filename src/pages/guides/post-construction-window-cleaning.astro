const faqs = [
  {
    question: "Doesn't the builder clean the windows before closing?",
    answer: "Most builders do a 'final clean', but it's usually a general cleaning crew wiping the visible glass. Sticker residue, film adhesive, paint specks, caulk smears, and debris in the tracks are commonly left behind.",
  },
  {
    question: "How long should I wait after construction to clean windows?",
    answer: "Clean once the dusty work (drywall sanding, exterior siding and masonry) is finished. Don't wait too long on protective film or stickers, though — the longer sunlight bakes them, the harder the adhesive is to remove.",
  },
  {
    question: "How much more does post-construction window cleaning cost?",
    answer: "Typically two to three times a normal maintenance cleaning, because every pane needs residue removal, not just a wash. The exact price depends on how much residue there is.",
  },
  {
    question: "Can I just wipe the drywall dust off myself?",
    answer: "Rinse it, don't dry-wipe it. Drywall and construction dust is abrasive — dragging a dry cloth or paper towel across it can leave fine scratches. Wet the glass first and let the dust rinse away.",
  },
];
