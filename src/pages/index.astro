---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config';

const { businessName, phone, phoneE164, serviceKeyword, serviceKeywordPlural, city, region, faqs, services, cities, testimonials, heroTagline, heroSubtext, heroAlt } = siteConfig;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer },
  })),
};
---

<BaseLayout
  title={`${businessName} | ${serviceKeyword.charAt(0).toUpperCase() + serviceKeyword.slice(1)} in ${city}`}
  description={`Need ${serviceKeyword} in ${city}? ${businessName} provides residential and commercial ${serviceKeywordPlural} in Florence, Covington, Fort Mitchell, and all across ${region}. Call ${phone} for a free estimate.`}
  schema={faqSchema}
>

<style>
  /* ===== BASE (mobile-first) ===== */
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; font-family: 'Inter', sans-serif; color: #333; }

  .container { max-width: 1100px; margin: 0 auto; padding: 0 1rem; }
  @media (min-width: 769px) {
    .container { padding: 0 2rem; }
  }

  /* Header */
  .site-header {
    background: #1a6bb5;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    gap: 1rem;
  }
  @media (min-width: 769px) {
    .header-inner { padding: 0.85rem 2rem; }
  }
  .mobile-quote-text {
    display: block;
    color: #cce4f7;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .phone-btn {
    color: #fff;
    font-size: 1.4rem;
    font-weight: 700;
    text-decoration: none;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
  }
  .nav-wrap { display: none; }
  .nav-links {
    display: flex;
    gap: 1.5rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    color: #fff;
    text-decoration: none;
  }

  /* Business name */
  .biz-name {
    font-size: 1.75rem;
    font-weight: 800;
    color: #111;
    line-height: 1.15;
    font-family: Georgia, 'Times New Roman', serif;
    padding: 1rem 0 0.25rem 0;
    margin: 0;
  }

  /* Hero + Form layout */
  .hero-form-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 1.5rem;
    padding-bottom: 1rem;
  }
  .hero-col { width: 100%; }
  .hero-col img {
    width: 100%;
    height: auto;
    max-height: 250px;
    object-fit: cover;
    display: block;
    border-radius: 10px;
  }


  /* Form */
  .form-col { width: 100%; }
  .form-banner {
    background: linear-gradient(135deg, #1a6bb5, #2d8fd5);
    color: #fff;
    text-align: center;
    border-radius: 10px 10px 0 0;
    padding: 1.5rem 1rem;
  }
  .form-banner-title {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0;
  }
  .form-banner-sub {
    color: #cce4f7;
    font-size: 0.95rem;
    margin: 0.35rem 0 0 0;
  }
  .form-card {
    background: #fff;
    border: 1px solid #ddd;
    border-top: none;
    border-radius: 0 0 10px 10px;
    padding: 1.25rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  }
  .form-note {
    font-size: 0.75rem;
    color: #666;
    margin: 0 0 0.75rem 0;
  }
  .form-group { margin-bottom: 0.85rem; }
  .form-group label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: #444;
    margin-bottom: 0.25rem;
  }
  .form-group input,
  .form-group textarea {
    width: 100%;
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 0.6rem 0.7rem;
    font-size: 16px; /* prevents iOS zoom */
    box-sizing: border-box;
    font-family: inherit;
  }
  .form-group textarea {
    resize: vertical;
    min-height: 80px;
  }
  .name-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .submit-btn {
    width: 100%;
    background: linear-gradient(135deg, #1a6bb5, #2d8fd5);
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
    padding: 0.85rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(26,107,181,0.25);
    font-family: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .submit-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(26,107,181,0.35);
  }

  /* Service type chips */
  .service-chips { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .service-chip {
    flex: 1;
    min-width: 0;
    text-align: center;
  }
  .service-chip input { display: none; }
  .service-chip label {
    display: block;
    padding: 0.5rem 0.75rem;
    border: 2px solid #ccc;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #555;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .service-chip input:checked + label {
    border-color: #1a6bb5;
    background: #e8f0fe;
    color: #1a6bb5;
  }
  .service-chip label:hover {
    border-color: #1a6bb5;
  }

  /* Hero social proof */
  .hero-social-proof {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.75rem 0;
    flex-wrap: wrap;
  }
  .stars {
    color: #fbbf24;
    font-size: 1.25rem;
    letter-spacing: 2px;
  }
  .review-count {
    font-size: 0.85rem;
    color: #555;
    font-weight: 600;
  }
  .google-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 0.3rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #333;
    text-decoration: none;
    transition: box-shadow 0.15s ease;
  }
  .google-badge:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    text-decoration: none;
  }
  .google-badge svg { width: 16px; height: 16px; }

  /* Pulse animation for CTA */
  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 4px 16px rgba(26,107,181,0.3); }
    50% { box-shadow: 0 4px 24px rgba(26,107,181,0.6); }
  }
  .call-now-btn {
    display: block;
    background: linear-gradient(135deg, #1a6bb5, #2d8fd5);
    color: #fff;
    font-weight: 800;
    font-size: 1.25rem;
    padding: 1rem;
    border-radius: 10px;
    text-decoration: none;
    text-align: center;
    margin: 1rem 0;
    animation: pulse-glow 2s ease-in-out infinite;
    letter-spacing: 0.5px;
  }
  .call-now-btn:hover { text-decoration: none; }

  /* Sticky mobile CTA */
  .sticky-mobile-cta {
    display: block;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(135deg, #1a6bb5, #0d4f8a);
    padding: 0.75rem 1rem;
    z-index: 999;
    box-shadow: 0 -2px 12px rgba(0,0,0,0.2);
    text-align: center;
  }
  .sticky-mobile-cta a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.15rem;
  }
  .sticky-mobile-cta .cta-sub {
    color: #cce4f7;
    font-size: 0.75rem;
    margin: 0.15rem 0 0 0;
  }
  @media (min-width: 769px) {
    .sticky-mobile-cta { display: none; }
  }

  /* Services grid */
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .service-card {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
  }
  .service-card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    display: block;
  }
  .service-card-body { padding: 1rem; }
  .service-card-body h3 {
    color: #1a6bb5;
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.4rem 0;
  }
  .service-card-body p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #555;
    margin: 0;
  }

  /* Section headings */
  .section-title {
    color: #1a6bb5;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.4rem 0;
    text-align: center;
  }
  .section-sub {
    color: #666;
    text-align: center;
    margin: 0 0 1.5rem 0;
    font-size: 1rem;
  }

  /* Content paragraphs */
  .content-text {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #444;
    margin-bottom: 1rem;
  }
  .content-text:last-child { margin-bottom: 0; }

  /* Testimonials */
  .testimonials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .testimonial-card {
    border-left: 4px solid #1a6bb5;
    background: #f8f9fa;
    padding: 1rem;
    border-radius: 0 8px 8px 0;
  }
  .testimonial-card .quote {
    font-style: italic;
    color: #444;
    margin: 0 0 0.5rem 0;
    line-height: 1.7;
    font-size: 0.95rem;
  }
  .testimonial-card .attribution {
    font-weight: 600;
    color: #1a6bb5;
    font-size: 0.8rem;
    margin: 0;
  }

  /* Service areas */
  .areas-list {
    list-style: disc;
    padding-left: 1.25rem;
    line-height: 2;
    color: #444;
    font-size: 0.95rem;
    columns: 2;
  }
  .areas-list a {
    color: #1a6bb5;
    text-decoration: none;
  }

  /* FAQ */
  .faq-item {
    padding: 1rem 0;
    border-bottom: 1px solid #e5e7eb;
  }
  .faq-item:last-child { border-bottom: none; }
  .faq-q {
    font-weight: 700;
    color: #1a6bb5;
    margin: 0 0 0.4rem 0;
    font-size: 1rem;
  }
  .faq-a {
    color: #555;
    font-size: 0.95rem;
    line-height: 1.75;
    margin: 0;
  }

  /* Final CTA */
  .final-cta {
    background: linear-gradient(135deg, #1a6bb5 0%, #155a96 100%);
    color: #fff;
    padding: 2.5rem 1.25rem;
    text-align: center;
  }
  .final-cta h2 {
    color: #fff;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
  }
  .final-cta p {
    color: #cce4f7;
    font-size: 1rem;
    margin: 0 0 1.5rem 0;
  }
  .final-cta-btn {
    display: inline-block;
    background: #fff;
    color: #1a6bb5;
    font-weight: 700;
    font-size: 1.1rem;
    padding: 1rem 2.5rem;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
  }

  /* Section spacing */
  .section { padding: 2rem 0; }

  /* ===== DESKTOP (769px+) ===== */
  @media (min-width: 769px) {
    .nav-wrap { display: block; }
    .mobile-quote-text { display: none; }
    .biz-name { font-size: 2.25rem; padding: 1rem 0 0.25rem 0; }

    .hero-form-row {
      flex-direction: row;
      gap: 2.5rem;
      align-items: flex-start;
    }
    .hero-col { flex: 1; min-width: 0; }
    .hero-col img { max-height: 340px; }
    .form-col { flex: 0 0 380px; }
    .name-row { flex-direction: row; gap: 0.75rem; }

    .services-grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .service-card img { height: 180px; }

    .testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    .areas-list { columns: 3; }

    .section { padding: 3rem 0; }
    .section-title { font-size: 1.75rem; }
  }
</style>

<!-- HEADER -->
<header class="site-header">
  <div class="container header-inner">
    <a href={`tel:${phoneE164}`} class="phone-btn">📞 {phone}</a>
    <span class="mobile-quote-text">Call us for a quote</span>
    <nav class="nav-wrap">
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/window-cleaning/">Services</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/reviews/">Reviews</a></li>
      </ul>
    </nav>
  </div>
</header>

<!-- CONTENT -->
<div class="container">

  <!-- Hero + Form -->
  <div class="hero-form-row">
    <div class="hero-col">
      <!-- Business name + tagline in left column -->
      <h1 class="biz-name">{heroTagline}</h1>
      <div class="hero-social-proof">
        <span class="stars">★★★★★</span>
        <span class="review-count">5.0 · 50+ Reviews</span>
        <a href="https://www.google.com/maps/place/NKY+Window+Cleaning+Pros" target="_blank" rel="noopener" class="google-badge">
          <svg viewBox="0 0 24 24" fill="none"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          Google Reviews
        </a>
      </div>
      <p style="font-size:1.1rem;color:#555;margin:0 0 1rem 0;line-height:1.5;">{heroSubtext}</p>
      <img src="/photos/hero.jpg" alt="{heroAlt}" loading="eager" />
      <a href={`tel:${phoneE164}`} class="call-now-btn">📞 CALL NOW — {phone}</a>
    </div>
    <div class="form-col">
      <div class="form-banner">
        <p class="form-banner-title">Get Your Free Quote</p>
        <p class="form-banner-sub">Takes 30 seconds · No obligation</p>
      </div>
      <form class="form-card" id="quote-form">
        <p class="form-note">* Indicates required field</p>
        <div class="form-group">
          <label>What do you need? *</label>
          <div class="service-chips">
            <div class="service-chip">
              <input type="radio" name="serviceType" id="svc-interior" value="Interior" required />
              <label for="svc-interior">Interior</label>
            </div>
            <div class="service-chip">
              <input type="radio" name="serviceType" id="svc-exterior" value="Exterior" />
              <label for="svc-exterior">Exterior</label>
            </div>
            <div class="service-chip">
              <input type="radio" name="serviceType" id="svc-both" value="Both" />
              <label for="svc-both">Both</label>
            </div>
          </div>
        </div>
        <div class="form-group">
          <label>Name *</label>
          <div class="name-row">
            <input type="text" name="firstName" required placeholder="First" />
            <input type="text" name="lastName" required placeholder="Last" />
          </div>
        </div>
        <div class="form-group">
          <label>Phone Number *</label>
          <input type="tel" name="phone" required />
        </div>
        <div class="form-group">
          <label>Email *</label>
          <input type="email" name="email" required />
        </div>
        <div class="form-group">
          <label>Details (optional)</label>
          <textarea name="comment" rows="3" placeholder="Number of windows, special requests, etc."></textarea>
        </div>
        <button type="submit" class="submit-btn" id="submit-btn">Get My Free Quote →</button>
      </form>
    </div>
  </div>

  <!-- Services -->
  <section class="section">
    <h2 class="section-title">Our Services</h2>
    <p class="section-sub">Professional {serviceKeywordPlural} for homes and businesses in {city}</p>
    <div class="services-grid">
      {services.map((service) => (
        <div class="service-card">
          <img src={service.photo} alt={`${service.title} — ${businessName}`} loading="lazy" />
          <div class="service-card-body">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Content -->
  <section class="section">
    <h2 class="section-title" style="text-align:left;">{serviceKeyword.charAt(0).toUpperCase() + serviceKeyword.slice(1)} in {city}</h2>
    <p class="content-text">If you need your windows cleaned in {city}, we are the team to call. We provide {serviceKeywordPlural} across {region}.</p>
    <p class="content-text">{businessName} has been providing {serviceKeywordPlural} across {city} for years. We clean windows on homes, offices, storefronts, and commercial buildings. Whether you need the inside of your windows cleaned, the outside cleaned, or both — we can handle it.</p>
    <p class="content-text">We use professional-grade equipment and eco-friendly cleaning solutions. Our purified water system leaves zero residue on your glass, so your windows stay cleaner longer.</p>
  </section>

  <!-- Testimonials -->
  <section class="section">
    <h2 class="section-title">What Our Customers Say</h2>
    <p class="section-sub">Reviews from homeowners and businesses across {city}</p>
    <div class="testimonials-grid">
      {testimonials.map((t) => (
        <div class="testimonial-card">
          <p class="quote">&#9733;&#9733;&#9733;&#9733;&#9733; "{t.quote}"</p>
          <p class="attribution">— {t.name}, {t.city}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Service Areas -->
  <section class="section">
    <h2 class="section-title">Service Areas</h2>
    <p class="section-sub">We serve all of {city}. Don't see your city? Call us at {phone}.</p>
    <ul class="areas-list">
      {cities.map((c) => (
        <li><a href={`/window-cleaning/${c.slug}/`}>{c.name}</a></li>
      ))}
    </ul>
  </section>

  <!-- FAQ -->
  <section class="section">
    <h2 class="section-title">Frequently Asked Questions</h2>
    <p class="section-sub">Common questions about our {serviceKeywordPlural}</p>
    {faqs.map((faq, i) => (
      <div class="faq-item">
        <p class="faq-q">{faq.question}</p>
        <p class="faq-a">{faq.answer}</p>
      </div>
    ))}
  </section>

</div>

<!-- Final CTA -->
<section class="final-cta">
  <h2>Ready to Get Your Windows Cleaned?</h2>
  <p>Call now for a free {serviceKeyword} estimate in {city}.</p>
  <a href={`tel:${phoneE164}`} class="final-cta-btn">Call {phone}</a>
</section>

<!-- Sticky Mobile Phone CTA -->
<div class="sticky-mobile-cta">
  <a href={`tel:${phoneE164}`} data-ga-event="phone_click" data-ga-source="sticky_mobile">
    📞 {phone} — Tap to Call
  </a>
  <p class="cta-sub">Free Estimates · Serving Northern Kentucky</p>
</div>

<script define:vars={{ businessName, phoneE164, ga4Id: siteConfig.ga4MeasurementId }}>
  (function() {
    // ── GA4 helper ──
    function trackEvent(name, params) {
      if (typeof gtag === 'function') {
        gtag('event', name, params || {});
      }
    }

    // ── GA4: phone_click events ──
    document.querySelectorAll('[data-ga-event="phone_click"]').forEach(function(el) {
      el.addEventListener('click', function() {
        trackEvent('phone_click', {
          event_category: 'engagement',
          event_label: el.getAttribute('data-ga-source') || 'header',
          phone_number: phoneE164,
        });
      });
    });

    // Also track header & hero phone links
    document.querySelectorAll('a[href^="tel:"]').forEach(function(el) {
      if (!el.getAttribute('data-ga-event')) {
        el.addEventListener('click', function() {
          trackEvent('phone_click', {
            event_category: 'engagement',
            event_label: 'phone_link',
            phone_number: phoneE164,
          });
        });
      }
    });

    // ── GA4: form_start event ──
    var form = document.getElementById('quote-form');
    if (!form) return;
    var formStarted = false;
    form.addEventListener('focusin', function() {
      if (!formStarted) {
        formStarted = true;
        trackEvent('form_start', {
          event_category: 'engagement',
          event_label: 'quote_form',
        });
      }
    });

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      e.stopPropagation();

      var btn = document.getElementById('submit-btn');
      btn.textContent = 'Sending...';
      btn.disabled = true;

      var serviceType = form.querySelector('input[name="serviceType"]:checked');
      var data = {
        site_name: businessName,
        service_type: serviceType ? serviceType.value : '',
        first_name: form.firstName.value,
        last_name: form.lastName.value,
        phone: form.phone.value,
        email: form.email.value,
        comment: form.comment.value,
        page_path: window.location.pathname,
      };

      var controller = new AbortController();
      setTimeout(function() { controller.abort(); }, 30000);

      fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
        signal: controller.signal,
      })
      .then(function(resp) {
        if (!resp.ok) throw new Error('Server error');
        return resp.json();
      })
      .then(function() {
        // GA4: generate_lead event
        trackEvent('generate_lead', {
          event_category: 'conversion',
          event_label: 'quote_form',
          service_type: data.service_type,
        });

        var card = document.querySelector('.form-card');
        if (card) {
          card.innerHTML = '<div style="text-align:center;padding:48px 24px;">' +
            '<div style="font-size:48px;margin-bottom:16px;">✅</div>' +
            '<h3 style="color:#1b4332;font-size:22px;margin-bottom:8px;">Thank You!</h3>' +
            '<p style="color:#52b788;font-size:15px;margin-bottom:24px;">We received your request and will get back to you within 24 hours.</p>' +
            '<a href="tel:' + phoneE164 + '" style="display:inline-block;background:linear-gradient(135deg,#2d6a4f,#40916c);color:#fff;text-decoration:none;font-size:14px;font-weight:600;padding:14px 36px;border-radius:8px;">📞 Call Us Now</a>' +
            '</div>';
        }
        btn.textContent = 'Submitted!';
        btn.style.background = '#22c55e';
      })
      .catch(function(err) {
        btn.textContent = 'Error — Try Again';
        btn.style.background = '#dc2626';
        btn.disabled = false;
        var existingError = form.querySelector('.form-error-msg');
        if (existingError) existingError.remove();
        var msg = document.createElement('p');
        msg.className = 'form-error-msg';
        msg.style.cssText = 'color:#dc2626;font-size:13px;margin-top:12px;text-align:center;';
        msg.textContent = 'Something went wrong. Please call us directly or try again.';
        btn.parentNode.insertBefore(msg, btn.nextSibling);
        setTimeout(function() {
          btn.textContent = 'Submit';
          btn.style.background = '';
          if (msg.parentNode) msg.remove();
        }, 4000);
      });
    });
  })();
</script>

</BaseLayout>
